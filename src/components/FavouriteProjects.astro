---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const projects = [
  {
    title:
      "Enterprise Network Segmentation & Advanced Linux Firewalling (iptables)",
    description: [
      "Designed and deployed a secure, production-grade network architecture from scratch in a Linux environment",
      "Implemented stateful firewalling with iptables, NAT/MASQUERADE rules, and strict traffic isolation policies",
      "Configured multi-zone segmentation to safeguard enterprise infrastructure against unauthorized lateral movements",
      "Validated security rules and network performance using command-line diagnostic tools",
    ],
    link: `${base}reports/tp5.pdf`,
    linkType: "pdf",
    tags: ["Cibersecurity", "Linux firewalls", "Iptables", "DMZ"],
  },
  {
    title: "Full-Stack Enterprise Mail Infrastructure & DNS Implementation",
    description: [
      "Deployed Postfix as MTA with MX record routing and configured Dovecot as MDA supporting IMAP4 and POP3 protocols",
      "Built a Roundcube webmail solution on a LAMP stack (Apache, MariaDB, PHP) with system user authentication",
      "Integrated standalone Mail User Agents (Thunderbird) and verified deliverability via dig and telnet diagnostics",
      "Established inter-domain mail routing and secondary DNS zone replication across multi-node virtual environments",
    ],
    link: `${base}reports/tp7.pdf`,
    linkType: "pdf",
    tags: ["DNS", "Mail Flow", "Dovecot", "Postfix", "SMTP", "POP3"],
  },
  {
    title:
      "Core Network Infrastructure: Automated DHCP, Caching DNS & Authoritative Multi-Node Architecture",
    description: [
      "Configured automated Layer 2 dynamic IP allocation through ISC dhcpd with defined address pools and lease policies",
      "Built a high-performance BIND DNS infrastructure with caching/forwarding resolvers and authoritative primary/secondary zones",
      "Implemented NAT/MASQUERADE via iptables, IPv4 forwarding, and routed web services across internal network segments",
      "Validated recursive queries, iterative resolution, and zone transfers using dig, nslookup, and dhclient lease analyses",
    ],
    link: `${base}reports/tp7.pdf`,
    linkType: "pdf",
    tags: ["DNS", "DHCP", "Linux", "Networking"],
  },
  {
    title: "SIEM Deployment, Hardening & Multi-Platform Log Centralization (Graylog)",
    description: [
      "Deployed and optimized a Graylog SIEM (Security Information and Event Management) infrastructure to centralize security event collection and enable proactive monitoring across a heterogeneous enterprise environment",
      "The project focused on platform hardening, log ingestion, and automated incident alerting to improve visibility and overall cybersecurity posture",
    ],
    link: `${base}reports/ti2-auditoria.pdf`,
    linkType: "pdf",
    tags: ["SIEM", "Cibersecurity", "Graylog", "VM"],
  },
];
---

<section id="favourite-projects" class="section favourite-projects">
  <div class="container">
    <p class="section-title">// favourite projects</p>
    <h2 class="section-heading">Favourite Projects</h2>

    <div class="projects-list">
      {
        projects.map((project) => (
          <div class="project-card">
            <ul class="project-description">
              {project.description.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <div class="project-header">
              <svg
                class="project-icon"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
              </svg>
              <span class="project-name">{project.title}</span>
            </div>

            <div class="project-footer">
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="project-tag">{tag}</span>
                ))}
              </div>

              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
              >
                {project.linkType === "pdf" ? (
                  <>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                      <line x1="16" y1="13" x2="8" y2="13" />
                      <line x1="16" y1="17" x2="8" y2="17" />
                      <polyline points="10 9 9 9 8 9" />
                    </svg>
                    View report
                  </>
                ) : (
                  <>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                    View repository
                  </>
                )}
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .favourite-projects {
    background: var(--bg-secondary);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.3s ease;
  }

  .project-card:hover {
    border-color: var(--accent);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }

  .project-description {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-description li {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    padding-left: 1.25rem;
    position: relative;
  }

  .project-description li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .project-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .project-name {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid rgba(0, 255, 136, 0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .project-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-glow);
  }
</style>
