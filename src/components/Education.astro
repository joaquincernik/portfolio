---
const education = [
  {
    degree: "Ingeniería en Informática",
    institution: "Instituto Universitario Aeronautico (UNDEF)",
    period: "2021 - 2026",
    status: "Último año",
    achievements: [
      "Materias de Seguridad: Criptografía, Redes, SO",
      "Desarrollo Full Stack: Web, Móvil, Backend",
      "Sistemas Embebidos y Tiempo Real",
      "Gestión de Proyectos y Metodologías Ágiles",
      "Promedio: 8.19"
    ]
  },
  {
    degree: "Analista en Sistemas Informáticos",
    institution: "Instituto Universitario Aeronautico (UNDEF)",
    period: "2021 - 2025",
    status: "Completado",
    achievements: [
      "Título intermedio logrado",
      "Proyectos de análisis y diseño de sistemas",
      "Bases de datos y modelado de información",
      "Promedio: 8.19"
    ]
  },
  {
    degree: "Full stack developer",
    institution: "Digital House",
    period: "2020",
    status: "Completado",
    achievements: [
      "Frontend: HTML, CSS, Javascript, React",
      "Backend: Nodejs",
      "Bases de datos: SQL",
    ]
  }
];

const certifications = [
  { name: "Advanced CEFR B2", issuer: "Anglia", year: "2021" },
  { name: "Introduction to cybersecurity", issuer: "Cisco", year: "2024" },
];
---

<section id="education" class="section education">
  <div class="container">
    <p class="section-title">// educación</p>
    <h2 class="section-heading">Formación académica</h2>
    
    <div class="education-grid">
      <div class="education-cards">
        {education.map((edu, index) => (
          <div class="education-card" data-index={index}>
            <div class="card-badge">{edu.status}</div>
            <h3 class="card-degree">{edu.degree}</h3>
            <p class="card-institution">{edu.institution}</p>
            <span class="card-period">{edu.period}</span>
            <ul class="card-achievements">
              {edu.achievements.map(achievement => (
                <li>{achievement}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="certifications">
        <h3 class="cert-title">Certificaciones</h3>
        <div class="cert-list">
          {certifications.map(cert => (
            <div class="cert-item">
              <div class="cert-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="8" r="6"/>
                  <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
                </svg>
              </div>
              <div class="cert-info">
                <span class="cert-name">{cert.name}</span>
                <span class="cert-meta">{cert.issuer} · {cert.year}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .education-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }

  .education-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .education-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    position: relative;
    transition: all 0.3s ease;
  }

  .education-card:hover {
    border-color: var(--accent);
    transform: translateX(8px);
  }

  .card-badge {
    position: absolute;
    top: -12px;
    right: 1.5rem;
    background: var(--accent);
    color: var(--bg-primary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .card-degree {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .card-institution {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .card-period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    display: block;
    margin-bottom: 1.5rem;
  }

  .card-achievements {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-achievements li {
    font-size: 0.9rem;
    color: var(--text-muted);
    padding-left: 1.25rem;
    position: relative;
  }

  .card-achievements li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .certifications {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75rem;
  }

  .cert-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .cert-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cert-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    background: var(--bg-tertiary);
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .cert-item:hover {
    background: var(--accent-glow);
  }

  .cert-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--accent-glow);
    border-radius: 8px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .cert-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cert-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .cert-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 968px) {
    .education-grid {
      grid-template-columns: 1fr;
    }

    .certifications {
      max-width: 500px;
    }
  }
</style>